# ── Telegram ──────────────────────────────────────────────
BOT_TOKEN=your_bot_token_here
WEBHOOK_URL=https://yourdomain.com/webhook    # خالی بذار برای polling
WEBHOOK_SECRET=your_random_secret_here

# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=exchange_db
POSTGRES_USER=exchange_user
POSTGRES_PASSWORD=strong_password_here

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_FSM_DB=1          # DB جدا برای FSM states
REDIS_CACHE_DB=2        # DB جدا برای cache نرخ ارز

# ── Celery ────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/3
CELERY_RESULT_BACKEND=redis://redis:6379/4

# ── Rate Service ──────────────────────────────────────────
RATE_CACHE_TTL=60              # ثانیه - TTL کش نرخ ارز
RATE_PROVIDER_URL=https://api.exchangerate-api.com/v4/latest/USD
RATE_PROVIDER_API_KEY=

# ── Security ──────────────────────────────────────────────
ADMIN_USER_IDS=123456789,987654321    # تلگرام آیدی ادمین‌ها
ENCRYPTION_KEY=your_32_byte_key_here  # برای رمزگذاری داده حساس

# ── App ───────────────────────────────────────────────────
APP_ENV=development        # development | production
LOG_LEVEL=INFO
SENTRY_DSN=               # خالی بذار اگه Sentry نمیخوای

# ── Limits ────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=30         # max request per window
RATE_LIMIT_WINDOW=60           # window به ثانیه
MAX_ORDERS_PER_DAY=10          # max سفارش روزانه هر کاربر
